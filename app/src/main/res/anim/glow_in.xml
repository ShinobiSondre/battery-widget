<?xml version="1.0" encoding="utf-8"?>
<!-- The next glow frame fades in on top of the current one. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="60"
    android:interpolator="@android:interpolator/linear"
    android:fromAlpha="0"
    android:toAlpha="1" />
