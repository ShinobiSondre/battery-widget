<?xml version="1.0" encoding="utf-8"?>
<!-- The current frame stays fully visible underneath while the next one fades in,
     so there is no dip in brightness between frames (that dip looked like a glitch). -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="60"
    android:fromAlpha="1"
    android:toAlpha="1" />
